---
import MainLayout from "../layouts/MainLayout.astro";
import SidebarNav from "../components/SidebarNav.astro";
import { profile } from "../data/profile";
import { stats, stages, impactIntro, impactCaveat } from "../data/impact";
---

<MainLayout
  title={`Impact — ${profile.name}`}
  description={`How ${profile.name} finds emerging engineering practice, gets an organization behind it, and ships it.`}
>
  <SidebarNav page="impact" />

  <main class="sb-content">
    <div class="sb-page">
      <h1 class="sb-h1">Impact</h1>
      <p class="sb-lede">{impactIntro}</p>

      <ul class="kpi-row">
        {
          stats.map((s) => (
            <li class="kpi">
              <span class="kpi-value">{s.value}</span>
              <span class="kpi-label">{s.label}</span>
              <span class="kpi-detail">{s.detail}</span>
            </li>
          ))
        }
      </ul>

      <ol class="sb-timeline">
        {
          stages.map((s) => (
            <li class="sb-role">
              <header class="sb-role-head">
                <div class="sb-role-title">
                  <span class="sb-company">{s.title}</span>
                  <span class="sb-title"> · {s.summary}</span>
                </div>
                <span class="sb-dates">{s.step}</span>
              </header>
              <p class="sb-desc">{s.detail}</p>
            </li>
          ))
        }
      </ol>

      <p class="sb-note">{impactCaveat}</p>
    </div>
  </main>
</MainLayout>

<style>
  .sb-content {
    margin-left: 300px;
    padding: 4.5rem 4rem 4rem;
    min-height: 100vh;
    line-height: 1.6;
  }

  .sb-page {
    max-width: 72ch;
    animation: sbFadeIn 0.45s ease-out;
  }

  .sb-h1 {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .sb-lede {
    margin: 0 0 2.4rem;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* ---- KPI row ---- */
  .kpi-row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    margin: 0 0 3rem;
    padding: 0;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .kpi {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.15rem 1.25rem 1.25rem;
    background: var(--surface);
  }

  .kpi-value {
    font-size: 2.35rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }

  .kpi-label {
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .kpi-detail {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* ---- stage timeline ---- */
  .sb-timeline {
    list-style: none;
    padding: 0 0 0 1.5rem;
    margin: 0;
    border-left: 2px solid var(--border);
  }

  .sb-role {
    position: relative;
    margin-bottom: 2.2rem;
  }

  .sb-role:last-child {
    margin-bottom: 0;
  }

  .sb-role::before {
    content: "";
    position: absolute;
    left: -1.96rem;
    top: 0.5em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg-fallback);
    box-shadow: 0 0 0 1px var(--accent-tint-border);
  }

  .sb-role-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.3rem 0.75rem;
  }

  .sb-company {
    font-weight: 600;
    font-size: 1.08rem;
  }

  .sb-title {
    color: var(--text-muted);
  }

  .sb-dates {
    font-size: 0.85rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .sb-desc {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .sb-note {
    margin: 2.6rem 0 0;
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  @keyframes sbFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sb-page {
      animation: none;
    }
  }

  @media (max-width: 820px) {
    .sb-content {
      margin-left: 0;
      padding: 1.75rem 1.25rem 2.5rem;
      min-height: 0;
    }

    .sb-h1 {
      font-size: 1.7rem;
    }

    .kpi-value {
      font-size: 2rem;
    }
  }
</style>
