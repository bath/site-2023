---
import MainLayout from "../layouts/MainLayout.astro";
import { profile, tools } from "../data/profile";
---

<MainLayout>
  <main class="page">
    <header>
      <p class="name">{profile.name}</p>
      <p class="place">{profile.location}</p>
    </header>

    <h1>{profile.hook}</h1>

    <section aria-labelledby="now">
      <h2 id="now">Now</h2>
      <p>
        I am the first engineering hire at <a href={profile.kanapy}>Kanapy</a>.
        Kanapy is for the people who put a building back after water, fire or
        storm damage: contractors, consultants and engineers. They capture a
        site visit on a phone. Kanapy turns the notes, photographs and room
        scans into the reports and paperwork the job needs.
      </p>
      <p>
        Since August 2026 I have rebuilt the product from an empty repository:
        one Expo codebase for iPhone and web, a FastAPI service, and AWS
        infrastructure as code. Rooty, the agent in the product, reads the
        record of a job and drafts the work. The expert corrects it and signs.
      </p>
      <p>
        Coding agents write most of the code. I built the factory around them: a
        server for each engineer where agents work in isolation, our own CI
        machines, a preview for each pull request, and pull requests that merge
        themselves when the risk is low. More than 1,000 of my changes have
        merged since August.
      </p>
    </section>

    <section aria-labelledby="next">
      <h2 id="next">Next</h2>
      <p>
        Agents that carry a loss from the first site visit to the final invoice,
        with the expert in control. Kanapy is hiring. Send me a message on <a
          href={profile.x}>X</a
        >.
      </p>
    </section>

    <section aria-labelledby="hark">
      <h2 id="hark">Hark</h2>
      <p>
        <a href={profile.hark}>Hark</a> is private dictation for the Mac. Press F5,
        talk, press F5 again. The text is pasted where the cursor is. The speech model
        runs on the Mac: no cloud, no account. I talk to agents all day, so I made
        the tool I wanted.
      </p>
      <p><code>brew install --cask bath/tap/hark</code></p>
    </section>

    <section aria-labelledby="tools">
      <h2 id="tools">Small tools</h2>
      <ul>
        {
          tools.map((t) => (
            <li>
              <a href={t.href}>{t.name}</a>
              <span>{t.note}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="before">
      <h2 id="before">Before</h2>
      <p>
        Five years at <a href="https://payitgov.com">PayIt</a> on government payments.
        I led Payment Plans, a recurring-payments product, from zero to production.
        It has processed more than $15M. Then I built agents and prompt tooling on
        the AI team.
      </p>
    </section>

    <footer>
      <p>
        <a href={profile.x}>X</a>
        <a href={profile.github}>GitHub</a>
        <a href={profile.linkedin}>LinkedIn</a>
        <a href={`mailto:${profile.email}`}>Email</a>
      </p>
      <p class="colophon">
        <a href={profile.sourceUrl}>Source</a>
      </p>
    </footer>
  </main>
</MainLayout>

<style>
  .page {
    max-width: 38rem;
    margin: 0 auto;
    padding: 5rem 1.25rem 4rem;
    line-height: 1.6;
  }

  .name {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .place {
    font-size: 0.9rem;
    color: var(--text-subtle);
  }

  h1 {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 2rem 0 0;
    text-wrap: balance;
  }

  section {
    margin-top: 2.5rem;
  }

  h2 {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-bottom: 0.6rem;
  }

  p + p {
    margin-top: 0.9rem;
  }

  section p,
  li {
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--text-faint);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }

  a:hover {
    text-decoration-color: var(--accent);
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    display: inline-block;
    max-width: 100%;
    overflow-x: auto;
    white-space: nowrap;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  li {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 1rem;
  }

  footer {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }

  footer p:first-child {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }

  .colophon a {
    color: var(--text-faint);
    font-size: 0.85rem;
  }

  @media (max-width: 600px) {
    .page {
      padding-top: 4rem;
    }

    h1 {
      font-size: 1.6rem;
    }

    li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
