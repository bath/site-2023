---
import MainLayout from "../layouts/MainLayout.astro";
import SidebarNav from "../components/SidebarNav.astro";
import { profile } from "../data/profile";
---

<MainLayout
  title={`${profile.name} — ${profile.title}`}
  description={profile.hook}
>
  <SidebarNav page="" />

  <main class="sb-content" id="main-content" tabindex="-1">
    <div class="sb-page">
      <p class="sb-greeting">
        <span class="sb-wave" aria-hidden="true">👋🏻</span>
        Hi — I'm {profile.name}.
      </p>

      <h1 class="sb-hook">{profile.hook}</h1>

      <div class="sb-summary">
        <p>
          I'm the first engineering hire at <a href={profile.companyUrl}
            >Kanapy</a
          >, bringing AI to the people who build and repair the places we live.
        </p>
        {profile.thinking.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <section class="sb-hiring" aria-labelledby="hiring-heading" id="hiring">
        <h2 id="hiring-heading">Build with us</h2>
        <p>
          {profile.hiring} If this is the work you want to do, I'd like to hear from
          you.
        </p>
        <a href={profile.hiringHref}
          >Email me about Kanapy <span aria-hidden="true">↗</span></a
        >
      </section>

      <p class="sb-previous">
        Previously at PayIt. <a href="/work#previous">See previous work</a>.
      </p>

      <p class="sb-contact">
        Reach out on <a href={profile.x}>X</a>, <a href={profile.linkedin}
          >LinkedIn</a
        >, or <a href={`mailto:${profile.email}`}>email</a>. You can also view
        my
        <a href={profile.github}>GitHub</a>.
      </p>

      <p class="sb-colophon">
        Built with <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        > — <a href={profile.sourceUrl}>this site is open source</a>.
      </p>
      <p class="sb-colophon"><a href="/llms.txt">Read this site as text</a></p>
    </div>
  </main>
</MainLayout>

<style>
  /* Content sits to the right of the 300px fixed rail on desktop, full-width
     on mobile (rail collapses to a top bar — see SidebarNav). */
  .sb-content {
    margin-left: 300px;
    padding: 4.5rem 4rem 4rem;
    min-height: 100vh;
    line-height: 1.6;
  }

  .sb-page {
    max-width: 60ch;
    animation: sbFadeIn 0.18s ease-out;
  }

  .sb-greeting {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin: 0 0 0.9rem;
  }

  .sb-wave {
    display: inline-block;
    margin-right: 0.2rem;
  }

  .sb-hook {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }

  .sb-summary p {
    font-size: 1.05rem;
    margin: 0 0 1.2rem;
  }

  .sb-summary a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--text-faint);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s ease;
  }

  .sb-summary a:hover {
    text-decoration-color: var(--accent);
  }

  .sb-hiring {
    margin-top: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.625rem;
    background: var(--surface);
  }

  .sb-hiring h2 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .sb-hiring p {
    margin: 0 0 0.75rem;
  }
  .sb-hiring a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-weight: 600;
  }
  .sb-hiring a,
  .sb-previous a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sb-previous {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .sb-contact {
    margin: 2rem 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
    font-size: 0.98rem;
    color: var(--text-muted);
  }

  .sb-contact a,
  .sb-colophon a {
    color: var(--link);
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .sb-contact a:hover,
  .sb-colophon a:hover {
    border-bottom-color: currentColor;
  }

  .sb-colophon {
    margin: 0.7rem 0 0;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .sb-colophon a {
    color: var(--text-subtle);
    font-weight: 400;
  }

  @keyframes sbFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sb-page {
      animation: none;
    }
  }

  @media (max-width: 820px) {
    .sb-content {
      margin-left: 0;
      padding: 1.75rem 1.25rem 2.5rem;
      min-height: 0;
    }

    .sb-hook {
      font-size: 1.55rem;
    }
  }
</style>
